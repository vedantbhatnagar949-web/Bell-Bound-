; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Bell Bound"
run/main_scene="res://scenes/menu/MainMenu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://scripts/managers/GameManager.gd"
StoryManager="*res://scripts/managers/StoryManager.gd"
NPCManager="*res://scripts/managers/NPCManager.gd"
DialogueManager="*res://scripts/managers/DialogueManager.gd"
GeminiManager="*res://scripts/managers/GeminiManager.gd"
PuzzleManager="*res://scripts/managers/PuzzleManager.gd"
EmotionManager="*res://scripts/managers/EmotionManager.gd"
CameraManager="*res://scripts/managers/CameraManager.gd"
TransitionManager="*res://scripts/managers/TransitionManager.gd"
SceneTransitionManager="*res://scripts/managers/SceneTransitionManager.gd"
AudioManager="*res://scripts/managers/AudioManager.gd"
SaveManager="*res://scripts/managers/SaveManager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=0
window/size/resizable=true
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/vsync/vsync_mode=1

[physics]

common/physics_ticks_per_second=60
3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
